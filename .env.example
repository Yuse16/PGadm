# PGadm — Environment Variables (example)
# Copy this file to .env and fill in values.

# Application
APP_NAME=PGadm
APP_ENV=development
APP_DEBUG=true
APP_PORT=3000

# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pgadm
DB_USERNAME=postgres
DB_PASSWORD=

# Authentication
JWT_SECRET=
SESSION_DRIVER=file

# API
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug
