# PGadm — Environment Variables (example)

# Application
APP_NAME=PGadm
APP_ENV=development
APP_DEBUG=true
APP_PORT=3000

# Database (future)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Authentication (future)
JWT_SECRET=
SESSION_DRIVER=file

# API (future)
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=

# Integrations (future)
INTEGRATION_INTELISIS_ENABLED=false
INTEGRATION_OPENROUTER_ENABLED=false

# AI (future)
AI_PROVIDER=

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug
