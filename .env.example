# PGadm — Environment Variables (example)
# Copy to .env.local and fill in your local values.
# Never commit real secrets, keys, or tokens.

# ── Application ──────────────────────────────────────────────
# APP_NAME=PGadm
# APP_ENV=development

# ── Supabase (Local Development) ─────────────────────────────
# Public variables (safe for browser):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Organization data source (Phase 1B.3D-2) ──────────────────
# demo = in-code demo fixtures (DEFAULT — auth is not required; org page reads
#        in-code fixtures). Kept as default by decision 1B.3D-2; flipping to
#        "supabase" is an ops decision after validating the RLS access matrix.
# supabase = anon reads through the Supabase client with RLS scoped to the
#            current session (organizations/branches/warehouses readable for
#            the active orgs only — migration 007). Requires auth configured.
# ORGANIZATION_DATA_SOURCE=demo

# ── Auth (Phase 1B.3D-2) ──────────────────────────────────────
# Required for real login (/login), the real session page (/admin/identity)
# and guards. Without them the login form shows a configuration error.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The session cookie for the local stack is sb-127-auth-token (PKCE flow).

# Private variables (server-only — never expose to client):
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# ── Database (direct — fallback, use Supabase client normally) ─
# OBLIGATORY in future phases:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=54322
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=

# ── Authentication (future) ──────────────────────────────────
# OBLIGATORY when auth is enabled:
# JWT_SECRET=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=

# ── API (future) ─────────────────────────────────────────────
# OPTIONAL:
# API_PREFIX=/api/v1
# CORS_ALLOWED_ORIGINS=

# ── External Integrations (future) ───────────────────────────
# OPTIONAL:
# INTEGRATION_INTELISIS_ENABLED=false
# INTEGRATION_OPENROUTER_ENABLED=false

# ── AI (future) ──────────────────────────────────────────────
# OPTIONAL:
# AI_PROVIDER=

# ── Logging ──────────────────────────────────────────────────
# OPTIONAL:
# LOG_LEVEL=debug
